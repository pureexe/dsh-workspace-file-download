{
  "name": "@local/dsh-workspace-file-download",
  "version": "1.0.0",
  "description": "Adds a download button to the DeepSeek Harness document preview pane (toolbar and unpreviewable-file states).",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "bundle",
    "web-ui",
    "document-preview",
    "download"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pureexe/dsh-workspace-file-download.git"
  },
  "bugs": {
    "url": "https://github.com/pureexe/dsh-workspace-file-download/issues"
  },
  "homepage": "https://github.com/pureexe/dsh-workspace-file-download#readme",
  "engines": {
    "dsh": ">=0.2.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-documentpreview",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
